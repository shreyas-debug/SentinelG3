# ─────────────────────────────────────────────────────────
# Sentinel-G3 | Environment Configuration
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your keys:
#   cp .env.template .env
# ─────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────

# Google Gemini 3 API Key
# Obtain from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
#
# If you set GEMINI_API_KEY in Windows “Environment variables” or in your
# terminal, this file still wins for the backend (project .env overrides shell).
# Remove the system/user variable if you prefer the shell key instead.

# ── Application Settings ─────────────────────────────────

APP_ENV=development
LOG_LEVEL=info

# ── CORS (Security — IMPORTANT for production) ───────────
# Comma-separated list of allowed frontend origins.
# Development default is "*" (all origins) — always override for production!
#
# Example for production:
# ALLOWED_ORIGINS=https://sentinel-g3-xi.vercel.app,http://localhost:3000
#
# For development, use "*" to allow all origins:
ALLOWED_ORIGINS=*

# ── Scan Settings ────────────────────────────────────────

# Maximum files to scan concurrently (semaphore). Reduce if hitting rate limits.
MAX_CONCURRENT_SCANS=3

# Semicolon-separated list of allowed local scan roots.
# Leave empty to allow any directory (not recommended for production).
# Example: ALLOWED_SCAN_ROOTS=C:\Users\Dev\Projects;D:\Work
ALLOWED_SCAN_ROOTS=

# ── Gemini Model Configuration ───────────────────────────

# Primary model — Flash is faster and has higher free-tier quota
GEMINI_MODEL=gemini-3-flash-preview

# Fallback model — switched to if Flash quota is exhausted
GEMINI_FALLBACK_MODEL=gemini-3-pro-preview
